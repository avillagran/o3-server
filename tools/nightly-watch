#!/usr/bin/env python3
"""Read upstream releases/source; produce review evidence without executing upstream code."""
import argparse
import collections
import datetime
import json
import os
import pathlib
import re
import subprocess
import urllib.request
BUILD_ROOT = os.environ.get('O3_BUILD_ROOT') or os.path.expanduser('~/.cache/o3-build')
os.makedirs(os.path.join(BUILD_ROOT, 'tmp'), exist_ok=True)

ROOT = pathlib.Path(__file__).resolve().parent.parent
REPO = 'https://github.com/pingdotgg/t3code.git'
PIN = '3f9448747bb8848050dc2cacf83affa6f94a66a1'
# Whole product tree: server, clients (web/desktop/mobile) and every package (providers,
# source-control, secrets, ssh...). Only the marketing site is excluded.
SURFACES = ['apps', 'packages', ':(exclude)apps/marketing']
LEDGER = ROOT / 'docs/nightly/ported.json'
CLIENT_ONLY = ('apps/web/', 'apps/desktop/', 'apps/mobile/')
TRIAGE = {'client-only': 'sin efecto en servidor', 'ported': 'portado', 'not-applicable': 'no aplica', 'partial': 'parcial', 'pending': 'pendiente'}


def git(cache, *args):
    return subprocess.check_output(['git', '-C', str(cache), *args], text=True, timeout=180).strip()


def releases():
    request = urllib.request.Request('https://api.github.com/repos/pingdotgg/t3code/releases?per_page=100', headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'o3-nightly-watch'})
    if os.environ.get('GH_TOKEN'):
        request.add_header('Authorization', 'Bearer ' + os.environ['GH_TOKEN'])
    with urllib.request.urlopen(request, timeout=45) as response:
        items = json.load(response)
    items = [r for r in items if not r['draft'] and re.fullmatch(r'v\d+\.\d+\.\d+-nightly\.\d{8}\.\d+', r['tag_name'])]
    if not items:
        raise ValueError('No published nightly in the latest 100 releases; refusing stale success')
    return sorted(items, key=lambda r: tuple(map(int, re.findall(r'\d+', r['tag_name']))), reverse=True)


def rpc_names(text):
    # Discovery only: no schema/semantic equivalence claim from this scan.
    names = set(re.findall(r'Rpc\.make\(\s*["\']([^"\']+)["\']', text))
    for block in re.findall(r'export const (?:ORCHESTRATION_V2_)?WS_METHODS\s*=\s*\{(.*?)\}\s*as const', text, re.S):
        names.update(re.findall(r':\s*["\']([^"\']+)["\']', block))
    if not names:
        raise ValueError('RPC discovery found no names; source layout may have changed')
    return sorted(names)


def collect(cache, selected):
    cache.mkdir(parents=True, exist_ok=True)
    if not (cache / 'HEAD').exists():
        subprocess.run(['git', 'init', '--bare', str(cache)], check=True, capture_output=True)
    refs = [PIN] + [r['tag_name'] for r in selected]
    subprocess.run(['git', '-C', str(cache), 'fetch', '--quiet', '--no-tags', '--filter=blob:none', REPO, *refs], check=True, timeout=240)
    # Explicit tag destinations: FETCH_HEAD alone does not retain all selected names.
    for r in selected:
        subprocess.run(['git', '-C', str(cache), 'fetch', '--quiet', '--no-tags', REPO, f"refs/tags/{r['tag_name']}:refs/tags/{r['tag_name']}"], check=True, timeout=180)
    def inventory(ref):
        return set(rpc_names('\n'.join(git(cache, 'show', ref + ':packages/contracts/src/' + file) for file in ('rpc.ts', 'orchestrationV2.ts'))))
    baseline = inventory(PIN)
    rows = []
    for r in selected:
        sha = git(cache, 'rev-parse', r['tag_name'] + '^{commit}')
        names = inventory(sha)
        files = git(cache, 'diff', '--name-status', PIN, sha, '--', *SURFACES).splitlines()
        previous = selected[selected.index(r) + 1]['tag_name'] if selected.index(r) + 1 < len(selected) else PIN
        commits = git(cache, 'log', '--format=%H %s', previous + '..' + sha, '--', *SURFACES).splitlines()
        neutral = sorted(k for k, v in touched(cache, previous + '..' + sha).items() if server_neutral(v))
        areas = collections.Counter('/'.join(line.split('\t')[-1].split('/')[:2]) for line in files)
        rows.append({'areasSincePinned': dict(sorted(areas.items())), 'tag': r['tag_name'], 'sha': sha, 'publishedAt': r['published_at'], 'url': r['html_url'], 'previous': previous, 'changesSincePrevious': commits, 'serverNeutral': neutral, 'changedFilesSincePinned': files, 'rpcAddedSincePinned': sorted(names - baseline), 'rpcRemovedSincePinned': sorted(baseline - names)})
    return rows


def server_neutral(paths):
    """True when a commit only touches upstream clients or tests; o3 clients are separate."""
    return bool(paths) and all(x.startswith(CLIENT_ONLY) or '.test.' in x or '/test/' in x or '/__tests__/' in x for x in paths)


def touched(cache, interval):
    paths, sha = {}, None
    for line in git(cache, 'log', '--format=%x01%H', '--name-only', interval, '--', *SURFACES).splitlines():
        if line.startswith('\x01'):
            sha = line[1:]
            paths[sha] = []
        elif line and sha:
            paths[sha].append(line)
    return paths


def ledger():
    if not LEDGER.exists():
        return {}
    data = json.loads(LEDGER.read_text())['commits']
    for sha, entry in data.items():
        if len(sha) != 40 or entry.get('status') not in TRIAGE:
            raise ValueError(f'invalid ported ledger entry {sha}')
    return data


def triage(line, entries, neutral=()):
    entry = entries.get(line.split(' ', 1)[0])
    if not entry and line.split(' ', 1)[0] in neutral:
        return f'[{TRIAGE["client-only"]}] {line}'
    if not entry:
        return f'[{TRIAGE["pending"]}] {line}'
    detail = ' '.join(x for x in (entry.get('o3', ''), entry.get('note', '')) if x)
    return f"[{TRIAGE[entry['status']]}] {line}" + (f' — {detail}' if detail else '')


def render(report, entries=None):
    entries = ledger() if entries is None else entries
    counts = report['portStatus']
    lines = ['# Seguimiento nightly de T3 Code', '', f"Referencia validada del inventario: `{PIN}`.", '', 'Detección de cambios; ninguna nightly está certificada por este informe.', '', '## Registro de portabilidad', '', *[f'- {k}: {v}' for k, v in sorted(counts.items())], '', '`done` conserva su evidencia y sus límites del inventario; no demuestra paridad completa.', '`skip` es backlog para paridad completa, aunque hoy no tenga consumidor.', 'RPC no cubre por sí solo HTTP, CLI, comandos, streams, UI ni comportamiento nativo.', '']
    for r in report['releases']:
        lines += [f"## {r['tag']}", '', f"Fuente: {r['url']}", f"Commit: `{r['sha']}`; publicada: {r['publishedAt']}.", f"Archivos de superficies vigiladas cambiados desde 3726: {len(r['changedFilesSincePinned'])}.", 'Áreas: ' + (', '.join(f'{k} {v}' for k, v in r.get('areasSincePinned', {}).items()) or 'ninguna') + '.', f"RPC nuevos detectados: {', '.join(r['rpcAddedSincePinned']) or 'ninguno'}.", f"RPC retirados detectados: {', '.join(r['rpcRemovedSincePinned']) or 'ninguno'}.", '', f"Cambios desde `{r['previous']}` (triage):", '']
        neutral = set(r.get('serverNeutral', []))
        lines += ['- ' + triage(c, entries, neutral) for c in r['changesSincePrevious']]
        lines += ['']
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--cache', type=pathlib.Path, default=pathlib.Path(os.path.join(BUILD_ROOT, 'upstream-watch.git')))
    parser.add_argument('--output', type=pathlib.Path, default=ROOT / 'docs/nightly')
    parser.add_argument('--count', type=int, default=5)
    args = parser.parse_args()
    if not 2 <= args.count <= 10:
        parser.error('--count must be between 2 and 10')
    rows = collect(args.cache, releases()[:args.count])
    status = json.loads((ROOT / 'docs/compat-status.json').read_text())
    report = {'checkedAt': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'pinnedCommit': PIN, 'portStatus': dict(collections.Counter(x['status'] for x in status['methods'].values())), 'releases': rows}
    args.output.mkdir(parents=True, exist_ok=True)
    (args.output / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
    (args.output / 'REPORT.md').write_text(render(report) + '\n')
    print(f"Latest: {rows[0]['tag']} {rows[0]['sha']}; evidence: {args.output}")


if __name__ == '__main__':
    main()
