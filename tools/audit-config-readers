#!/usr/bin/env python3
"""Read-only, per-field grep inventory for the three config/settings compatibility rows."""
import json,pathlib,re,subprocess
repo=pathlib.Path(__file__).resolve().parent.parent
roots=[repo.parent/'lib-t3-rust',repo.parent/'omarchy-t3-code',repo.parent/'ot3-android']
fields=set('environment directEndpoints auth cwd keybindingsConfigPath keybindings issues providers availableEditors observability settings shellResumeCompletionMarker threadResumeCompletionMarker shellThreadFamilies shellOlderSettled threadSnapshotPagination instanceId driver displayName accentColor enabled installed version status checkedAt message models slug name isDefault isCustom aliases capabilities optionDescriptors id label type options currentValue description slashCommands skills path scope setup canAuthenticate canInstall canLogout auth email workspaceId reportsContextWindow supportsConversationRollback nativeSessions canList canLoad canResume versionAdvisory updateState serviceTier serviceTiers defaultServiceTier environmentThemes usageLimitSources usageLimitsCommand snapshot providerStatuses settingsUpdated keybindingsUpdated environmentThemesUpdated usageLimitSourcesUpdated payload sources themes accounts plan usageLimits windows kind usedPercent resetsAt windowDurationMins unavailable reason resetCredits availableCount nextExpiresAt credentialFingerprint externalUsage url environment sensitive value valueRedacted binaryPath homePath shadowHomePath launchArgs customModels autoCompactWindow idleCompaction'.split())
def visit(v):
 if isinstance(v,dict):
  for k,val in v.items(): fields.add(k);visit(val)
 elif isinstance(v,list):
  for val in v:visit(val)
visit(json.loads((repo/'src/settings-defaults.json').read_text()))
fields.update('environmentId label platform os arch serverVersion orchestrationProtocolVersion devices repositoryIdentity threadSettlement threadSnooze threadPinning threadAutoSettleOptOut threadTitleRegeneration policy bootstrapMethods sessionMethods sessionCookieName logsDirectoryPath localTracingEnabled otlpTracesEnabled otlpMetricsEnabled otlpLogsEnabled'.split())
manifest=json.loads((repo/'src/claude-models.json').read_text())
for profile in manifest['profiles'].values(): visit(profile['capabilities'])
lines=['# Config/settings reader inventory','','Generated by `tools/audit-config-readers` against read-only sibling client sources. Each cell is an exact-name/spelling grep location; hits are candidates, not proof of semantic consumption. Generic provider forms, model option descriptors, settings projection and quota reducers are reviewed in CONFORMANCE.md. No source text or machine data is copied.','','| Field | Shared library | Desktop src/ui | Android production |','|---|---|---|---|']
unread=[]
for field in sorted(fields):
 cells=[]
 variants={field,re.sub(r'(?<!^)(?=[A-Z])','_',field).lower(),re.sub(r'(?<!^)(?=[A-Z])','-',field).lower()}
 pattern='|'.join(map(re.escape,sorted(variants)))
 for root in roots:
  dirs=[root/p for p in ['src','ui','app/src/main','core/src/main','t3-lib/src/main'] if (root/p).is_dir()]
  if not dirs:raise RuntimeError(f'Missing reader sources: {root.name}')
  result=subprocess.run(['rg','-n',pattern,*map(str,dirs),'--glob','*.rs','--glob','*.qml','--glob','*.kt'],text=True,capture_output=True)
  if result.returncode not in (0,1):raise RuntimeError(result.stderr)
  hits=[]
  for line in result.stdout.splitlines():
   path,num,_=line.split(':',2);loc=f'{pathlib.Path(path).relative_to(root)}:{num}'
   if loc not in hits:hits.append(loc)
  cells.append(', '.join(f'`{h}`' for h in hits[:3])+(' …' if len(hits)>3 else '') if hits else 'no match')
 lines.append('| `'+field+'` | '+' | '.join(cells)+' |')
 if all(cell=='no match' for cell in cells):unread.append(field)
lines += ['', '## Fields without literal production reads', '', 'These are the complete zero-match candidates in the table. Their config/settings round trips are retained. Accepted representation/optional differences and generic descriptor readers are explained in CONFORMANCE.md; in particular, generic service-tier options still require implementation despite zero literal hits.', '', ', '.join('`'+field+'`' for field in unread)+'.']
(repo/'docs/CONFIG-READER-AUDIT.md').write_text('\n'.join(lines)+'\n')
print(f'{len(fields)} fields inventoried')
