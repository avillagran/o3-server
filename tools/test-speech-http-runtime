#!/usr/bin/env python3
"""Build and snapshot the real CLI, then exercise local speech offline in private Podman."""
import argparse, fcntl, hashlib, json, os, pathlib, stat, subprocess, uuid
from speech_runtime_admission import require_rootless, require_target

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--inputs', required=True, type=pathlib.Path)
parser.add_argument('--node', required=True, type=pathlib.Path)
parser.add_argument('--evidence-root', required=True, type=pathlib.Path)
parser.add_argument('--image', default='localhost/o3-server-tests:local')
parser.add_argument('--default-features', action='store_true')
args = parser.parse_args()
root = pathlib.Path(__file__).resolve().parent.parent
target = require_target()
require_rootless()
for path in [args.inputs, args.node, args.evidence_root]:
    if not path.is_absolute() or path.is_symlink():
        parser.error('Inputs, Node, and evidence root require absolute non-link paths')
node_digest = '0adde40d1b7dfa57c8bc83cbc319758c3ec6ebba21363bb2fa752ea6b267ad1b'
with os.fdopen(os.open(args.node, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as source:
    before = os.fstat(source.fileno())
    assert stat.S_ISREG(before.st_mode) and not before.st_mode & 0o222
    assert hashlib.file_digest(source, 'sha256').hexdigest() == node_digest
    after = os.fstat(source.fileno())
    assert (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
runtime = args.evidence_root / ('http-cpu-' + uuid.uuid4().hex)
runtime.mkdir(mode=0o700)
evidence = runtime / 'evidence'
evidence.mkdir(mode=0o700)

def snapshot(source_path, destination):
    with os.fdopen(os.open(source_path, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as source, destination.open('xb') as output:
        before = os.fstat(source.fileno())
        assert stat.S_ISREG(before.st_mode)
        while block := source.read(1024 * 1024):
            output.write(block)
        after = os.fstat(source.fileno())
        assert (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
    destination.chmod(0o500)

env = dict(os.environ, CARGO_TARGET_DIR=str(target), CARGO_BUILD_JOBS='2', CARGO_NET_OFFLINE='true', CARGO_PROFILE_DEV_DEBUG='0')
def source_hashes():
    paths = sorted(root.glob('src/**/*.rs')) + sorted(root.glob('runtime/speech/*')) + [root / 'tools/reference/speech-http-4314/acceptance.py', root / 'tools/test-speech-http-runtime']
    return {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths if path.is_file()}
frozen = source_hashes()
with open('/var/tmp/o3-build/o3-parity-compile.lock', 'a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    with (runtime / 'compile.log').open('w') as log:
        built = subprocess.run(['cargo', 'build', '--locked', *([] if args.default_features else ['--no-default-features']), '--bin', 'o3-server'], cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT)
    if built.returncode:
        raise SystemExit(built.returncode)
    snapshot(target / 'debug/o3-server', runtime / 'o3-server')
    (runtime / 'deps').mkdir(mode=0o700)
    for library in sorted((target / 'debug/deps').glob('*.so')):
        snapshot(library, runtime / 'deps' / library.name)
assert source_hashes() == frozen, 'Source changed during compilation'
snapshot(root / 'tools/reference/speech-http-4314/acceptance.py', runtime / 'acceptance.py')
proof = {'sourceSha256': frozen, 'binarySha256': hashlib.sha256((runtime / 'o3-server').read_bytes()).hexdigest(), 'nodeSha256': node_digest, 'defaultFeatures': args.default_features, 'nativeRevision': '83a3674ffd84ffb33de768210c806cb1ac53fd80', 'scope': 'actual local CPU HTTP/WS, no cloud, microphone, network or recognition-accuracy claim'}
(runtime / 'inputs.json').write_text(json.dumps(proof, indent=2) + '\n')
cmd = ['podman', '--remote=false', 'run', '--rm', '--pull=never', '--http-proxy=false', '--timeout=240', '--userns=keep-id', '--user', f'{os.getuid()}:{os.getgid()}', '--read-only', '--network=none', '--cap-drop=ALL', '--security-opt=no-new-privileges', '--pids-limit=128', '--cpus=4', '--memory=4g', '--tmpfs', '/tmp:rw,exec,size=512m,mode=1777', '--env', 'HOME=/tmp/home', '--env', 'LD_LIBRARY_PATH=/runtime/deps', '-v', f'{runtime}:/runtime:ro', '-v', f'{evidence}:/evidence:rw', '-v', f'{args.node}:/node-bin/node:ro', '-v', f'{args.inputs}:/inputs:ro', args.image, 'python3', '/runtime/acceptance.py']
# The production application independently verifies the same immutable Node digest.
with (runtime / 'physical.log').open('w') as log:
    result = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT)
proof['sourceUnchanged'] = source_hashes() == frozen
proof['returncode'] = result.returncode
(runtime / 'result.json').write_text(json.dumps(proof, indent=2) + '\n')
print(runtime)
assert proof['sourceUnchanged'], 'Source changed during acceptance'
raise SystemExit(result.returncode)
