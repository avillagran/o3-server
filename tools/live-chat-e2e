#!/usr/bin/env python3
"""Run two inexpensive native turns through the real client in isolated provider homes."""
import os, pathlib, shutil, subprocess, tempfile
root=pathlib.Path(__file__).resolve().parent.parent
# Build before changing HOME so cargo retains its normal registry/cache access.
env={**os.environ,'TMPDIR':'/var/tmp/o3-build/tmp','CARGO_TARGET_DIR':'/var/tmp/o3-build/main'}
# Find the executable via cargo's JSON artifact metadata, avoiding stale hashes.
p=subprocess.run(['nice','cargo','test','--locked','-j','4','--test','provider_input','--no-run','--message-format=json'],cwd=root,env=env,check=True,capture_output=True,text=True)
import json
binary=next(v['executable'] for line in p.stdout.splitlines() if (v:=json.loads(line)).get('executable') and v.get('target',{}).get('name')=='provider_input')
original=pathlib.Path.home()
with tempfile.TemporaryDirectory(prefix='o3-live-',dir='/var/tmp/o3-build') as temp:
    home=pathlib.Path(temp)
    for folder,name in [('.claude','.credentials.json'),('.codex','auth.json')]:
        destination=home/folder/name;destination.parent.mkdir(mode=0o700)
        shutil.copyfile(original/folder/name,destination);destination.chmod(0o600)
    env.update(HOME=temp,T3CODE_HOME=str(home/'t3'),CLAUDE_CONFIG_DIR=str(home/'.claude'),CODEX_HOME=str(home/'.codex'),XDG_CONFIG_HOME=str(home/'config'),XDG_DATA_HOME=str(home/'data'),XDG_STATE_HOME=str(home/'state'))
    subprocess.run([binary,'live_claude_and_codex_through_real_client','--ignored','--nocapture'],env=env,cwd=root,check=True)
