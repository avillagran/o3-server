#!/bin/sh
set -eu
export TMPDIR=/var/tmp/o3-build/tmp
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/o3-build/main}
mkdir -p "$TMPDIR"
filter=upstream_differential
if [ "${1:-}" = concurrent ]; then filter=upstream_concurrent_differential; fi
exec nice cargo test -j 4 --no-default-features --test differential "$filter" -- --ignored --nocapture --test-threads=1
