#!/usr/bin/env python3
"""Run reviewed whole-native page functions against a retained private Chromium owner."""
import argparse,json,os,pathlib,subprocess,tempfile,hashlib,uuid
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--case',choices=['real-page','retention','contracts','relay'],default='real-page');p.add_argument('--native',type=pathlib.Path,required=True);p.add_argument('--playwright',type=pathlib.Path,required=True);p.add_argument('--deps',type=pathlib.Path,required=True);p.add_argument('--node',type=pathlib.Path,required=True);p.add_argument('--guard',type=pathlib.Path,required=True);p.add_argument('--evidence-root',type=pathlib.Path,required=True);a=p.parse_args()
manifest=json.loads((pathlib.Path(__file__).resolve().parent.parent/'runtime/preview/native-manifest.json').read_text())
for name,digest in manifest['files'].items():
 item=a.native/name;assert item.is_file() and not item.is_symlink() and hashlib.sha256(item.read_bytes()).hexdigest()==digest,name
assert json.loads((a.deps/'node_modules/effect/package.json').read_text())['version']=='4.1.2'
artifact=a.playwright.parent/'artifact.json';assert hashlib.sha256(artifact.read_bytes()).hexdigest()=='58221afe10da094f6bc55b5e9166eff06b6ff761ad4031e97614f0f15e941a09'
for row in json.loads(artifact.read_text())['files']:
 item=a.playwright.parent/row['path'];assert item.is_file() and not item.is_symlink() and hashlib.sha256(item.read_bytes()).hexdigest()==row['sha256'],row['path']
assert subprocess.check_output(['podman','--remote=false','info','--format','{{.Host.Security.Rootless}}'],text=True).strip()=='true'
a.evidence_root.mkdir(parents=True,exist_ok=True);out=pathlib.Path(tempfile.mkdtemp(prefix='page-',dir=a.evidence_root));out.chmod(0o700);source=pathlib.Path(__file__).resolve().parent.parent
snapshot=out/'source';hashes={}
for directory in ['runtime/preview','tests/preview']:
 for item in (source/directory).glob('*.mjs'):
  assert item.is_file() and not item.is_symlink()
  relative=item.relative_to(source);target=snapshot/relative;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(item.read_bytes());target.chmod(0o400);hashes[str(relative)]=hashlib.sha256(target.read_bytes()).hexdigest()
(out/'source.json').write_text(json.dumps(hashes,indent=2)+'\n')
bootstrap='''
import pathlib,subprocess
pathlib.Path('/out/home').mkdir(mode=0o700)
modules=pathlib.Path('/native/node_modules');(modules/'@t3tools').mkdir()
for entry in pathlib.Path('/deps/node_modules').iterdir():
 if entry.name!='@t3tools':(modules/entry.name).symlink_to(entry)
for name in ['contracts']:(modules/'@t3tools'/name).symlink_to('/native/packages/'+name)
raise SystemExit(subprocess.run(['/node/bin/node','--experimental-vm-modules','/source/tests/preview/real-page.mjs']).returncode)
