bootstrap=bootstrap.replace('real-page.mjs',a.case+'.mjs')
container='o3-native-page-'+uuid.uuid4().hex
cmd=['podman','--remote=false','run','--name',container,'--label','o3.preview-proof='+container,'--rm','--pull=never','--http-proxy=false','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--read-only','--network=none','--cap-drop=ALL','--security-opt=no-new-privileges','--pids-limit=512','--memory=4g','--tmpfs','/tmp:rw,size=512m,mode=1777','--tmpfs','/native/node_modules:rw,size=32m,mode=1777','--env','HOME=/out/home','--env','XDG_CONFIG_HOME=/out/home/config','--env','XDG_CACHE_HOME=/out/home/cache']
for root,target,mode in [(pathlib.Path('/usr'),'/usr','ro'),(snapshot,'/source','ro'),(a.native,'/native','ro'),(a.playwright,'/playwright','ro'),(a.deps,'/deps','ro'),(a.node,'/node','ro'),(a.guard,'/guard.mjs','ro'),(out,'/out','rw')]:cmd+=['-v',f'{root.resolve()}:{target}:{mode}']
