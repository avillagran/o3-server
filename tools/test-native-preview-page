 try:result=subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,timeout=90);code=result.returncode
 except subprocess.TimeoutExpired:
  code=124
  # Only this uniquely named, owner-labelled container can be stopped.
  inspected=subprocess.run(['podman','--remote=false','inspect',container],capture_output=True,text=True,timeout=10)
  if inspected.returncode==0:
   info=json.loads(inspected.stdout)[0];assert info['Config']['Labels'].get('o3.preview-proof')==container
   subprocess.run(['podman','--remote=false','stop','--time','5',info['Id']],stdout=log,stderr=subprocess.STDOUT,timeout=15,check=True)
(out/'result.json').write_text(json.dumps({'exit':code,'retained':str(out),'source':str(source),'network':'none','rootless':True},indent=2)+'\n');print(out);print((out/'runtime.log').read_text());raise SystemExit(code)
