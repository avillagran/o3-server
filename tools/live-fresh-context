#!/usr/bin/env python3
"""Build acceptance without running it on the host, then execute in rootless podman."""
import argparse, json, os, pathlib, subprocess, tempfile, uuid
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--export-database", type=pathlib.Path)
parser.add_argument("--reference-root", type=pathlib.Path)
parser.add_argument("--scheduled-tasks", action="store_true")
parser.add_argument("--scheduled-store", action="store_true", help="Capture official task/webhook persistence without provider credentials or inference")
options = parser.parse_args()
if options.scheduled_tasks and options.export_database:
    parser.error("--scheduled-tasks cannot be combined with --export-database")
if options.scheduled_store and (not options.reference_root or options.scheduled_tasks or options.export_database):
    parser.error("--scheduled-store requires --reference-root and cannot be combined with other scenarios")
root = pathlib.Path(__file__).resolve().parent.parent
build_env = dict(os.environ)
build_env.setdefault('CARGO_TARGET_DIR', '/var/tmp/o3-server/fresh-context-target')
build = subprocess.run(['cargo', 'test', '--locked', '--no-default-features', '--test', 'fresh_context_live', '--no-run', '--message-format=json'], cwd=root, env=build_env, capture_output=True, text=True)
if build.returncode:
    for line in build.stdout.splitlines():
        diagnostic = json.loads(line).get("message", {})
        if diagnostic.get("rendered"):
            print(diagnostic["rendered"], flush=True)
    print(build.stderr, flush=True)
    raise SystemExit(build.returncode)
binary = next(pathlib.Path(v['executable']) for line in build.stdout.splitlines() if (v := json.loads(line)).get('executable') and v.get('target', {}).get('name') == 'fresh_context_live')
credentials=[]
native_mounts=[]
if options.scheduled_store:
    pass
elif options.export_database:
    native_mounts=[(options.export_database.resolve(), '/input/native.sqlite')]
else:
    claude = pathlib.Path(subprocess.check_output(['mise', 'where', 'claude'], text=True).strip()).resolve()
    codex = pathlib.Path(subprocess.check_output(['mise', 'where', 'codex'], text=True).strip()).resolve()
    original = pathlib.Path.home()
    credentials = [(original / '.claude/.credentials.json', '/input/claude.json'), (original / '.codex/auth.json', '/input/codex.json')]
    for source, _ in credentials:
        if not source.is_file():
            raise SystemExit(f'Missing native authentication file: {source}')
    native_mounts=[(claude,'/native/claude'),(codex,'/native/codex'),*credentials]

if options.reference_root:
    reference=options.reference_root.resolve()
    if not (reference/'t3').is_file():
        raise SystemExit('Reference root must contain the extracted t3 binary')
    node=pathlib.Path(subprocess.check_output(['mise','where','node'],text=True).strip()).resolve()
    native_mounts += [(reference,'/reference'),(node,'/native/node')]

state = pathlib.Path(tempfile.mkdtemp(prefix='o3-fresh-native-', dir='/var/tmp'))
evidence = state / 'evidence'
evidence.mkdir(mode=0o700)
name = 'o3-fresh-' + uuid.uuid4().hex
args = ['podman', 'run', '--rm', '--name', name, '--userns=keep-id', '--user', f'{os.getuid()}:{os.getgid()}', '--read-only', '--tmpfs', '/tmp:rw,exec,size=3g,mode=1777', '--cap-drop=ALL', '--security-opt=no-new-privileges', '--pids-limit=1024', '--memory=6g', '--network=' + ('none' if options.export_database or options.scheduled_store else 'pasta'), '--workdir=/tmp']
for source, target in [(root, root), (binary.parent, '/test-bin'), *native_mounts]:
    args += ['-v', f'{source}:{target}:ro']
args += ['-v', f'{evidence}:/evidence:rw']
for key, value in {'HOME':'/tmp/home', 'CLAUDE_CONFIG_DIR':'/tmp/home/.claude', 'CODEX_HOME':'/tmp/home/.codex', 'T3CODE_HOME':'/tmp/home/t3', 'XDG_CONFIG_HOME':'/tmp/home/config', 'XDG_DATA_HOME':'/tmp/home/data', 'XDG_STATE_HOME':'/tmp/home/state', 'PATH':'/native/claude:/native/codex/bin:/native/node/bin:/usr/local/bin:/usr/bin:/bin', 'O3_FRESH_CONTEXT_CONTAINER':'1', 'O3_FRESH_CONTEXT_EVIDENCE':'/evidence'}.items():
    args += ['--env', f'{key}={value}']
if options.reference_root:
    args += ['--env','O3_FRESH_CONTEXT_REFERENCE=/reference/t3']
test_name='official_scheduled_store_retains_pending_coalescence_and_replay' if options.scheduled_store else 'shared_native_projection_export' if options.export_database else ('scheduled_tasks_native_conversation_modes' if options.scheduled_tasks else 'native_resets_forget_prior_context_but_keep_history_and_new_continuations')
setup='set -eu; umask 077; mkdir -p "$HOME/.claude" "$HOME/.codex"; '
if not options.export_database and not options.scheduled_store:
    setup+='cp /input/claude.json "$HOME/.claude/.credentials.json"; cp /input/codex.json "$HOME/.codex/auth.json"; '
default_image = 'localhost/o3-server-tests:local' if options.scheduled_store else 'localhost/android-sandbox:latest'
args += [os.environ.get('O3_FRESH_CONTEXT_IMAGE', default_image), 'sh', '-c', setup+'exec /test-bin/"$1" "$2" --ignored --nocapture --test-threads=1', 'fresh-context', binary.name, test_name]
print(f'Fresh-context acceptance evidence: {evidence}', flush=True)
try:
    result = subprocess.run(args, cwd=root, timeout=600)
finally:
    # The unique container name is never supplied by provider output or an evidence file.
    subprocess.run(['podman', 'stop', '--time', '3', name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
raise SystemExit(result.returncode)
