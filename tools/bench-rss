#!/usr/bin/env python3
"""Isolated release RSS probe, using a real authenticated WebSocket and 1000 durable messages."""
from runtime_safety import require_private_runtime, retained_directory
require_private_runtime()
import base64,hashlib,json,os,pathlib,socket,struct,subprocess,sys,time
sys.dont_write_bytecode=True
if '--profile' in sys.argv:
 from rss_profile import run
 # Keep the existing sampler shared by both workloads.
 def profile_memory(pid):
  return {k:int(v.split()[0]) for k,v in (line.split(':',1) for line in pathlib.Path(f'/proc/{pid}/status').read_text().splitlines() if ':' in line) if k in ('VmRSS','VmHWM','RssAnon','RssFile','Threads','THP_enabled')}
