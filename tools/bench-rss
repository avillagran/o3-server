#!/usr/bin/env python3
"""Isolated release RSS probe, using a real authenticated WebSocket and 1000 durable messages."""
import base64,hashlib,json,os,pathlib,socket,struct,subprocess,sys,tempfile,time
repo=pathlib.Path(__file__).resolve().parent.parent
build_dir=os.environ.get('CARGO_TARGET_DIR','/var/tmp/o3-build/main')
if len(sys.argv)<2:
 subprocess.run(['nice','cargo','build','--release','--locked','-j','6'],cwd=repo,env={**os.environ,'CARGO_TARGET_DIR':build_dir},check=True)
binary=pathlib.Path(sys.argv[1] if len(sys.argv)>1 else build_dir+'/release/o3-server').resolve()
assert '/release/' in str(binary), 'benchmark requires a release binary' 
class WS:
 def __init__(self,port,token):
  self.s=socket.create_connection(('127.0.0.1',port),timeout=120)
  self.s.sendall((f'GET /ws?orchestrationProtocol=2 HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: {base64.b64encode(os.urandom(16)).decode()}\r\nAuthorization: Bearer {token}\r\n\r\n').encode())
  header=b''
  while not header.endswith(b'\r\n\r\n'):header+=self.s.recv(1)
  assert b' 101 ' in header,header
 def send(self,v):
  b=json.dumps(v).encode();mask=os.urandom(4);n=len(b);head=bytes([0x81,0x80|(n if n<126 else 126 if n<65536 else 127)])
  if n>=126:head+=struct.pack('!H' if n<65536 else '!Q',n)
  self.s.sendall(head+mask+bytes(c^mask[i%4] for i,c in enumerate(b)))
 def read(self,n):
  b=b''
  while len(b)<n:
   part=self.s.recv(n-len(b))
   if not part:raise EOFError()
   b+=part
  return b
 def recv(self):
  parts=[]
  while True:
   a,b=self.read(2);n=b&127
   if n==126:n=struct.unpack('!H',self.read(2))[0]
   if n==127:n=struct.unpack('!Q',self.read(8))[0]
   parts.append(self.read(n))
   if a&128:return json.loads(b''.join(parts))
 def rpc(self,tag,payload):
  self.send({'_tag':'Request','id':'1','tag':tag,'payload':payload,'headers':[]});v=self.recv();assert v['exit']['_tag']=='Success',v;return v['exit']['value']
def memory(pid):
 return {k:int(v.split()[0]) for k,v in (line.split(':',1) for line in pathlib.Path(f'/proc/{pid}/status').read_text().splitlines() if ':' in line) if k in ('VmRSS','VmHWM','RssAnon')}
with tempfile.TemporaryDirectory(prefix='o3-rss-',dir='/var/tmp/o3-build') as temp:
 env={**os.environ,'T3CODE_HOME':temp,'HOME':temp,'CODEX_HOME':str(pathlib.Path(temp)/'codex'),'CLAUDE_CONFIG_DIR':str(pathlib.Path(temp)/'claude')}
 token=subprocess.check_output([str(binary),'auth','session','issue','--scope','orchestration:read','--scope','orchestration:operate','--scope','providers:manage','--token-only'],env=env,text=True).strip()
 process=subprocess.Popen([str(binary),'serve','--port','0','--host','127.0.0.1'],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 try:
  runtime=pathlib.Path(temp)/'userdata/server-runtime.json';deadline=time.monotonic()+90
  while not runtime.exists():
   assert process.poll() is None and time.monotonic()<deadline
   time.sleep(.01)
  port=json.loads(runtime.read_text())['port'];cold=memory(process.pid)
  ws=WS(port,token)
  ws.rpc('server.refreshProviders',{})
  config=ws.rpc('server.getConfig',{})
  while not (pathlib.Path(temp)/'omabridge/endpoint.json').exists():
   assert time.monotonic()<deadline, 'bridge startup timeout'
   time.sleep(.05)
  providers=config['providers']
  assert {p['instanceId'] for p in providers}=={'claude','codex'},providers
  ws.rpc('orchestration.dispatchCommand',{'type':'thread.create','commandId':'create','threadId':'rss-thread','projectId':'rss-project','title':'RSS workload','modelSelection':{'instanceId':'scripted','model':'test','options':[]},'runtimeMode':'full-access','interactionMode':'default','branch':None,'worktreePath':None})
  for j in range(1,20):ws.rpc('orchestration.dispatchCommand',{'type':'thread.create','commandId':f'create-{j}','threadId':f'thread-{j}','projectId':'rss-project','title':'RSS thread','modelSelection':{'instanceId':'scripted','model':'test','options':[]},'runtimeMode':'full-access','interactionMode':'default'})
  for i in range(1000):ws.rpc('orchestration.dispatchCommand',{'type':'message.dispatch','commandId':f'c{i}','messageId':f'm{i}','threadId':'rss-thread','text':f'message {i}: '+('x'*1000),'attachments':[],'dispatchMode':{'type':'defer_start'}})
  ws.s.close();time.sleep(.1);idle=memory(process.pid)
  subscribers=[];counts=[]
  for i in range(3):
   ws=WS(port,token);subscribers.append(ws)
   ws.send({'_tag':'Request','id':str(i),'tag':'orchestration.subscribeThread','payload':{'threadId':'rss-thread','acceptBoundedSnapshot':True,'acceptCompactIds':True,'acceptDedupedBodies':True,'acceptCompactTurnItems':True},'headers':[]})
  for i,ws in enumerate(subscribers):
   snapshot=ws.recv();assert snapshot['_tag']=='Chunk';counts.append(len(snapshot['values'][0]['projection']['messages']));ws.send({'_tag':'Ack','requestId':str(i)})
  subscribed=memory(process.pid)
  churn=WS(port,token)
  for i in range(1000):churn.rpc('server.getSettings',{})
  churn.s.close();time.sleep(.2)
  final=memory(process.pid)
  result={'measured_at_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'binary':str(binary),'binary_bytes':binary.stat().st_size,'seed_messages':1000,'threads':20,'subscribers':3,'unary_calls':1000,'text_bytes_per_message':1000,'cold_kib':cold,'seeded_kib':idle,'subscribed_kib':subscribed,'after_churn_kib':final,'snapshot_messages':counts,'under_50_mib':final['VmHWM']<50*1024,'providers':[{'instanceId':p['instanceId'],'installed':p.get('installed'),'status':p.get('status')} for p in providers],'bridge_enabled':True,'provider_workload':'registered and probed; inference excluded (defer_start)','measurement':'Linux /proc/PID/status; disk profile under /var/tmp','allocator_env':{k:v for k,v in env.items() if k.startswith('MIMALLOC_')}}
  print(json.dumps(result,indent=2))
  for ws in subscribers:ws.s.close()

 finally:
  process.terminate();process.wait(timeout=5)
