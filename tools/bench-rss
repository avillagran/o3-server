repo=pathlib.Path(__file__).resolve().parent.parent
build_dir=os.environ.get('CARGO_TARGET_DIR','/var/tmp/o3-build/main')
if len(sys.argv)<2:
 subprocess.run(['nice','cargo','build','--release','--locked','-j','4'],cwd=repo,env={**os.environ,'CARGO_TARGET_DIR':build_dir,'TMPDIR':'/var/tmp/o3-build/tmp'},check=True)
binary=pathlib.Path(sys.argv[1] if len(sys.argv)>1 else build_dir+'/release/o3-server').resolve()
assert '/release/' in str(binary), 'benchmark requires a release binary' 
class WS:
 def __init__(self,port,token):
  self.s=socket.create_connection(('127.0.0.1',port),timeout=120)
  self.s.sendall((f'GET /ws?orchestrationProtocol=2 HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: {base64.b64encode(os.urandom(16)).decode()}\r\nAuthorization: Bearer {token}\r\n\r\n').encode())
  header=b''
  while not header.endswith(b'\r\n\r\n'):header+=self.s.recv(1)
  assert b' 101 ' in header,header
 def send(self,v):
  b=json.dumps(v).encode();mask=os.urandom(4);n=len(b);head=bytes([0x81,0x80|(n if n<126 else 126 if n<65536 else 127)])
  if n>=126:head+=struct.pack('!H' if n<65536 else '!Q',n)
  self.s.sendall(head+mask+bytes(c^mask[i%4] for i,c in enumerate(b)))
 def read(self,n):
  b=b''
  while len(b)<n:
   part=self.s.recv(n-len(b))
   if not part:raise EOFError()
   b+=part
  return b
 def recv(self):
  parts=[]
  while True:
   a,b=self.read(2);n=b&127
   if n==126:n=struct.unpack('!H',self.read(2))[0]
   if n==127:n=struct.unpack('!Q',self.read(8))[0]
   parts.append(self.read(n))
   if a&128:return json.loads(b''.join(parts))
 def rpc(self,tag,payload):
  self.send({'_tag':'Request','id':'1','tag':tag,'payload':payload,'headers':[]});v=self.recv();assert v['exit']['_tag']=='Success',v;return v['exit']['value']
def memory(pid):
 return {k:int(v.split()[0]) for k,v in (line.split(':',1) for line in pathlib.Path(f'/proc/{pid}/status').read_text().splitlines() if ':' in line) if k in ('VmRSS','VmHWM','RssAnon','RssFile','Threads','THP_enabled')}
with retained_directory(prefix='o3-rss-',dir='/var/tmp/o3-build') as temp:
 env={**os.environ,'T3CODE_HOME':temp,'HOME':temp,'CODEX_HOME':str(pathlib.Path(temp)/'codex'),'CLAUDE_CONFIG_DIR':str(pathlib.Path(temp)/'claude')}
 browser_fixture=os.environ.get('O3_BENCH_BROWSER_FIXTURE')=='1'
 if browser_fixture:env['O3_BROWSER_BINARY']=str(repo/'tests/fixtures/browser-cdp.py')
 token=subprocess.check_output([str(binary),'auth','session','issue','--scope','orchestration:read','--scope','orchestration:operate','--scope','providers:manage','--scope','preview:operate','--token-only'],env=env,text=True).strip()
 gateway_args=[]
 if os.environ.get('O3_BENCH_GATEWAY')=='1':
  cert=pathlib.Path(temp)/'cert.pem';key=pathlib.Path(temp)/'key.pem'
  subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-keyout',str(key),'-out',str(cert),'-days','1','-subj','/CN=localhost','-addext','subjectAltName=DNS:localhost'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  with socket.socket() as reserve:
   reserve.bind(('127.0.0.1',0)); gateway_port=reserve.getsockname()[1]
  gateway=pathlib.Path(temp)/'gateway.json'
  gateway.write_text(json.dumps({'bind':'127.0.0.1','certificates':{'localhost':[str(cert),str(key)]},'gateways':[{'host':'localhost','port':gateway_port,'peer':'self','service':'t3'}]}))
  gateway_args=['--bridge-gateway-config',str(gateway)]
 process_started=time.perf_counter()
 process=subprocess.Popen([str(binary),'serve','--port','0','--host','127.0.0.1']+gateway_args,env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 try:
  runtime=pathlib.Path(temp)/'userdata/server-runtime.json';deadline=time.monotonic()+90
  while not runtime.exists():
   assert process.poll() is None and time.monotonic()<deadline
   time.sleep(.01)
  port=json.loads(runtime.read_text())['port'];cold=memory(process.pid)
  ws=WS(port,token)
  startup_to_websocket_ms=(time.perf_counter()-process_started)*1000
  ws.rpc('server.refreshProviders',{})
  config=ws.rpc('server.getConfig',{})
  browser_idle=None
  if browser_fixture:
   ws.rpc('preview.open',{'threadId':'rss-browser','runtime':'server','profileId':'incognito','url':'http://localhost:1234'})
   profile=pathlib.Path(temp)/'userdata/browser-profiles'
   pid=int(next(profile.glob('*/fixture.pid')).read_text())
   browser_idle={'server_kib':memory(process.pid),'fixture_child_kib':memory(pid),'child_kind':'Python CDP fixture, not Chromium','actual_chromium_rss':None}

  while not (pathlib.Path(temp)/'omabridge/endpoint.json').exists():
   assert time.monotonic()<deadline, 'bridge startup timeout'
   time.sleep(.05)
  if gateway_args:
   status=pathlib.Path(temp)/'omabridge/gateways.status.json'
   while not status.exists() or not any(v['running'] for v in json.loads(status.read_text()).values()):
    assert process.poll() is None and time.monotonic()<deadline, 'TLS gateway startup timeout'
    time.sleep(.05)
  providers=config['providers']
  assert {p['instanceId'] for p in providers}=={'claudeAgent','codex'},providers
  ws.rpc('orchestration.dispatchCommand',{'type':'thread.create','commandId':'create','threadId':'rss-thread','projectId':'rss-project','title':'RSS workload','modelSelection':{'instanceId':'scripted','model':'test','options':[]},'runtimeMode':'full-access','interactionMode':'default','branch':None,'worktreePath':None})
  for j in range(1,20):ws.rpc('orchestration.dispatchCommand',{'type':'thread.create','commandId':f'create-{j}','threadId':f'thread-{j}','projectId':'rss-project','title':'RSS thread','modelSelection':{'instanceId':'scripted','model':'test','options':[]},'runtimeMode':'full-access','interactionMode':'default'})
  selection={'modelSelection':{'instanceId':'scripted','model':'test','options':[]}} if os.environ.get('O3_BENCH_MODEL_SELECTION')=='1' else {}
  append_ms=[]
  for i in range(1000):
   begin=time.perf_counter()
   ws.rpc('orchestration.dispatchCommand',{'type':'message.dispatch','commandId':f'c{i}','messageId':f'm{i}','threadId':'rss-thread','text':f'message {i}: '+('x'*1000),**selection,'attachments':[],'dispatchMode':{'type':'defer_start'}})
   append_ms.append((time.perf_counter()-begin)*1000)
  metadata_ms=[]
  for i in range(100):
   begin=time.perf_counter()
   ws.rpc('orchestration.dispatchCommand',{'type':'thread.metadata.update','commandId':f'title-{i}','threadId':'rss-thread','title':f'History append {i}'})
   metadata_ms.append((time.perf_counter()-begin)*1000)
  ws.s.close();time.sleep(.1);idle=memory(process.pid)
  subscribers=[];counts=[]
  for i in range(3):
   ws=WS(port,token);subscribers.append(ws)
   ws.send({'_tag':'Request','id':str(i),'tag':'orchestration.subscribeThread','payload':{'threadId':'rss-thread','acceptBoundedSnapshot':True,'acceptCompactIds':True,'acceptDedupedBodies':True,'acceptCompactTurnItems':True},'headers':[]})
  for i,ws in enumerate(subscribers):
   snapshot=ws.recv();assert snapshot['_tag']=='Chunk';counts.append(len(snapshot['values'][0]['projection']['messages']));ws.send({'_tag':'Ack','requestId':str(i)})
  subscribed=memory(process.pid)
  churn=WS(port,token)
  for i in range(1000):churn.rpc('server.getSettings',{})
  churn.s.close();time.sleep(.2)
  final=memory(process.pid)
  result={'startup_to_websocket_ms':startup_to_websocket_ms,'measured_at_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'binary':str(binary),'binary_bytes':binary.stat().st_size,'seed_messages':1000,'message_model_selection':bool(selection),'append_last_100_ms':{'median':sorted(append_ms[-100:])[50],'p95':sorted(append_ms[-100:])[94],'max':max(append_ms[-100:])},'metadata_append_100_ms':{'median':sorted(metadata_ms)[50],'p95':sorted(metadata_ms)[94],'max':max(metadata_ms)},'threads':20,'subscribers':3,'unary_calls':1000,'text_bytes_per_message':1000,'cold_kib':cold,'seeded_kib':idle,'subscribed_kib':subscribed,'after_churn_kib':final,'snapshot_messages':counts,'under_50_mib':final['VmHWM']<50*1024,'under_50_mb':final['VmHWM']*1024<50_000_000,'providers':[{'instanceId':p['instanceId'],'installed':p.get('installed'),'status':p.get('status')} for p in providers],'bridge_enabled':True,'gateway_hosting':bool(gateway_args),'provider_workload':'registered and probed; inference excluded (defer_start)','measurement':'Linux /proc/PID/status; disk profile under /var/tmp','allocator_env':{k:v for k,v in env.items() if k.startswith('MIMALLOC_')}}
  result['browser_idle']=browser_idle
  print(json.dumps(result,indent=2))
  assert result['under_50_mb'], 'server HWM exceeded 50 MB'
  for ws in subscribers:ws.s.close()

 finally:
  process.terminate();process.wait(timeout=5)
