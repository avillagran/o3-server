#!/usr/bin/env python3
"""Run pinned native dialog reference bodies in a private rootless container."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
for name in ("checkout", "staged", "deps", "node", "cr-page", "dialog", "evidence-root"):
    parser.add_argument("--" + name, type=Path, required=True)
parser.add_argument("--image", default="localhost/o3-rust-tests:latest")
args = parser.parse_args()
if os.getuid() == 0:
    raise SystemExit("A non-root caller and rootless Podman are required")
rootless = subprocess.check_output(["podman", "info", "--format", "{{.Host.Security.Rootless}}"], text=True).strip()
if rootless != "true":
    raise SystemExit("Rootless Podman is required")
common = Path(subprocess.check_output(["git", "-C", str(args.checkout), "rev-parse", "--path-format=absolute", "--git-common-dir"], text=True).strip())
args.evidence_root.mkdir(parents=True, exist_ok=True)
evidence = Path(tempfile.mkdtemp(prefix="native-dialogs-", dir=args.evidence_root))
command = ["podman", "run", "--rm", "--network=none", "--read-only", "--userns=keep-id", "--user", f"{os.getuid()}:{os.getgid()}", "--security-opt=no-new-privileges", "--cap-drop=all", "--pids-limit=128", "--memory=1g", "--tmpfs", "/tmp:rw,nosuid,nodev,size=128m", "--env", "HOME=/tmp/private"]
mounts = [(args.checkout, "/checkout", True), (common, str(common), True), (args.node, "/node", True), (args.staged, "/staged", True), (args.deps / "node_modules", "/tmp/native-node_modules", True), (Path(__file__).resolve().with_suffix(".mjs"), "/generator.mjs", True), (args.cr_page, "/crPage.ts", True), (args.dialog, "/dialog.ts", True), (evidence, "/evidence", False)]
for source, destination, readonly in mounts:
    command += ["--mount", f"type=bind,src={source.resolve()},dst={destination}" + (",ro" if readonly else "")]
command += [args.image, "/node/bin/node", "/generator.mjs", "/checkout", "/staged", "/crPage.ts", "/dialog.ts", "/evidence/fixture.json"]
result = subprocess.run(command, capture_output=True, text=True, timeout=90)
(evidence / "output.log").write_text(result.stdout + result.stderr)
(evidence / "result.json").write_text(json.dumps({"returncode": result.returncode, "retainedEvidence": str(evidence), "rootless": True, "network": "none"}, indent=2) + "\n")
print(evidence)
print(result.stdout + result.stderr)
raise SystemExit(result.returncode)
