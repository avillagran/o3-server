#!/usr/bin/env python3
"""Package an existing server and exact Node capsule; no download or execution.

This is a release/install action, not a test/build owner. Never run it to create
extra runtime copies in an acceptance workflow. Existing outputs are retained
and rejected; failure leaves its concrete partial package for inspection.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import stat

NODE_SHA256 = '0adde40d1b7dfa57c8bc83cbc319758c3ec6ebba21363bb2fa752ea6b267ad1b'
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--server', type=Path, required=True)
p.add_argument('--node', type=Path, required=True)
p.add_argument('--output', type=Path, required=True)
a = p.parse_args()

def regular(path):
    if not path.is_absolute() or '..' in path.parts:
        raise SystemExit('Absolute canonical input required')
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for index, component in enumerate(path.parts[1:]):
            last = index == len(path.parts[1:]) - 1
            child = os.open(component, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | (0 if last else os.O_DIRECTORY), dir_fd=fd)
            os.close(fd)
            fd = child
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o6000:
            raise SystemExit('Ordinary input file required')
        return os.fdopen(os.dup(fd), 'rb'), info
    finally:
        os.close(fd)

def source(path, expected=None):
    stream, before = regular(path)
    digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    stream.seek(0)
    if stream.read(4) != b'\x7fELF' or (expected and digest != expected):
        stream.close()
        raise SystemExit('Package artifact admission failed')
    stream.seek(0)
    return stream, before, digest

server, server_info, server_hash = source(a.server)
node, node_info, node_hash = source(a.node, NODE_SHA256)
output = a.output
if not output.is_absolute() or '..' in output.parts or output.parent.resolve(strict=True) != output.parent:
    raise SystemExit('Absolute package output below a canonical existing parent required')
output.mkdir(mode=0o700)  # exclusive; no replacement or cleanup
(output / 'runtime').mkdir(mode=0o700)
artifacts = {}
for name, stream, before, digest in [('o3-server', server, server_info, server_hash), ('runtime/node-26.13.0', node, node_info, node_hash)]:
    target = output / name
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o500)
    with stream, os.fdopen(fd, 'wb') as destination:
        while block := stream.read(65536):
            destination.write(block)
        destination.flush()
        os.fsync(destination.fileno())
        after = os.fstat(stream.fileno())
        if any(getattr(before, key) != getattr(after, key) for key in ['st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns']):
            raise SystemExit('Input changed; partial package retained')
    with target.open('rb') as check:
        if hashlib.file_digest(check, 'sha256').hexdigest() != digest:
            raise SystemExit('Package verification failed; partial package retained')
    artifacts[name] = {'sha256': digest, 'bytes': before.st_size}
with (output / 'native-search-package.json').open('x') as receipt:
    json.dump({'version': 1, 'artifacts': artifacts, 'node': '26.13.0', 'runtimeIsExistingPrivateImmutableCapsule': True, 'executed': False}, receipt, indent=2)
    receipt.write('\n')
print(output)
