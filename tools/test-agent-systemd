#!/usr/bin/env python3
"""Exercise native agent scopes inside a disposable rootless systemd container."""
import argparse
import json
import pathlib
import subprocess
import sys
import time
import uuid

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--image', default='localhost/o3-rust-tests:latest')
parser.add_argument('--no-default-features', action='store_true')
options = parser.parse_args()
root = pathlib.Path(__file__).resolve().parent.parent
security = subprocess.check_output(['podman', 'info', '--format', '{{.Host.Security.Rootless}}'], text=True).strip()
if security != 'true':
    raise SystemExit('Rootless Podman is required')
subprocess.run(['podman', 'image', 'exists', options.image], check=True)
build = subprocess.run(['cargo', 'test', '--locked', '--lib', '-j', '2', *(['--no-default-features'] if options.no_default_features else []), '--no-run', '--message-format=json'], cwd=root, capture_output=True, text=True)
binary = None
for line in build.stdout.splitlines():
    item = json.loads(line)
    if item.get('message', {}).get('rendered'):
        print(item['message']['rendered'], flush=True)
    if item.get('executable') and item.get('profile', {}).get('test'):
        binary = pathlib.Path(item['executable']).resolve()
print(build.stderr, file=sys.stderr, end='', flush=True)
if build.returncode:
    raise SystemExit(build.returncode)
if not binary:
    raise SystemExit('Cargo produced no library test executable')
name = 'o3-agent-systemd-' + uuid.uuid4().hex
args = ['podman', 'run', '--detach', '--rm', '--timeout=120', '--pull=never', '--name', name,
        '--systemd=always', '--cgroupns=private', '--network=none', '--read-only',
        '--tmpfs', '/run:rw,size=32m,notmpcopyup', '--tmpfs', '/tmp:rw,exec,size=128m,mode=1777,notmpcopyup',
        '--tmpfs', '/var:rw,size=32m,notmpcopyup', '--cap-drop=ALL', '--security-opt=no-new-privileges',
        '--memory=768m', '--pids-limit=128', '--stop-timeout=3', '--user=0:0', '--workdir=/tmp',
        '-v', f'{binary.parent}:/test-bin:ro', '--env=HOME=/tmp/home', '--env=TMPDIR=/tmp',
        '--env=XDG_RUNTIME_DIR=/tmp/runtime', '--env=O3_AGENT_SYSTEMD_CONTAINER=1',
        '--entrypoint=/sbin/init', options.image, '--unit=basic.target']

def execute(command, **kwargs):
    return subprocess.run(['podman', 'exec', name, *command], **kwargs)

result = None
try:
    subprocess.run(args, check=True, capture_output=True, text=True, timeout=30)
    setup = "import os;os.makedirs('/tmp/home',mode=0o700);os.makedirs('/tmp/runtime',mode=0o700);assert os.statvfs('/').f_flag & os.ST_RDONLY;assert os.statvfs('/test-bin').f_flag & os.ST_RDONLY"
    execute(['python3', '-c', setup], check=True, timeout=10)
    # Launch the user manager directly: the namespace has no PAM credential-changing
    # capabilities, and requires neither a host bus nor a host runtime directory.
    subprocess.run(['podman', 'exec', '--detach', name, '/usr/lib/systemd/systemd', '--user', '--unit=basic.target'], check=True, capture_output=True, text=True, timeout=10)
    deadline = time.monotonic() + 15
    while True:
        try:
            ready = execute(['systemctl', '--user', 'show-environment'], capture_output=True, timeout=2)
            if ready.returncode == 0:
                break
        except subprocess.TimeoutExpired:
            pass
        if time.monotonic() > deadline:
            raise RuntimeError('The disposable systemd user manager did not become ready')
        time.sleep(0.1)
    print('Running native scope lifecycle in private PID/cgroup namespaces; OOM fixture is capped at 32 MiB', flush=True)
    result = execute([f'/test-bin/{binary.name}', '--ignored', '--exact', 'agent_scope::tests::native_systemd_reaps_detached_children_preserves_shared_processes_and_reports_oom', '--nocapture', '--test-threads=1'], timeout=90)
finally:
    try:
        if result is None or result.returncode:
            execute(['journalctl', '--no-pager', '-n', '20'], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass
    finally:
        subprocess.run(['podman', 'rm', '--force', '--time', '3', name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
raise SystemExit(result.returncode)
