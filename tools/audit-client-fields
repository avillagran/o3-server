#!/usr/bin/env python3
"""Inventory consumers of differing P0 field names in the retained differential report.
This identifies candidates to inspect; a zero-match field is not automatic acceptance.
"""
import json, pathlib, subprocess, re, itertools
root=pathlib.Path(__file__).resolve().parent.parent
report=json.loads((root/'docs/conformance-report.json').read_text())
registry=json.loads((root/'docs/compat-status.json').read_text())
methods={k for k,v in registry['methods'].items() if v['priority'] in ('P0','P1')}
fields=set()
def differences(a,b):
    if isinstance(a,dict) or isinstance(b,dict):
        a=a if isinstance(a,dict) else {}
        b=b if isinstance(b,dict) else {}
        for key in a.keys()|b.keys():
            if key.startswith('$'):continue
            if key not in a or key not in b or a[key]!=b[key]:
                fields.add(key)
                differences(a.get(key),b.get(key))
    elif isinstance(a,list) or isinstance(b,list):
        a=a if isinstance(a,list) else []
        b=b if isinstance(b,list) else []
        for x,y in itertools.zip_longest(a,b): differences(x,y)
for row in report['results']:
    if row['surface'] in methods: differences(row['o3'],row['upstream'])
roots=[root.parent/name for name in ['lib-t3-rust','omarchy-t3-code','ot3-android']]
lines=['# P0/P1 field consumer audit','', 'Source: retained nightly 3991 shape report; not a new differential run. Grep scans all text file types, including hidden/ignored source files and bindings/data, using camelCase, PascalCase, snake_case and kebab-case spellings. Hits are candidates, not proof of a read; accepted exceptions are reviewed in CONFORMANCE.md.','', '| Field | lib-t3-rust | desktop | Android |','|---|---|---|---|']
for field in sorted(fields-{'items','error','projection','snapshot'}):
    cells=[]
    for path in roots:
        sources=[path/p for p in ['src','ui','bindings','data','app/src/main','core/src/main','t3-lib/src/main'] if (path/p).is_dir()]
        if not sources: raise RuntimeError(f'no source roots: {path}')
        variants={field,field[:1].upper()+field[1:],re.sub(r'(?<!^)(?=[A-Z])','_',field).lower(),re.sub(r'(?<!^)(?=[A-Z])','-',field).lower()}
        r=subprocess.run(['rg','-l','-e','|'.join(map(re.escape,sorted(variants))),*map(str,sources),'--no-ignore','--hidden','--sort','path'],capture_output=True,text=True)
        if r.returncode not in (0,1): raise RuntimeError(r.stderr)
        files=r.stdout.splitlines()
        cells.append(', '.join('`'+str(pathlib.Path(f).relative_to(path))+'`' for f in files[:3])+(' …' if len(files)>3 else '') if files else 'no match')
    lines.append('| `'+field+'` | '+' | '.join(cells)+' |')
(root/'docs/P0-FIELD-AUDIT.md').write_text('\n'.join(lines)+'\n')
print(f'{len(lines)-6} field names audited')
