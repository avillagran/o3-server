#!/usr/bin/env python3
"""Measure an isolated release server from disk; second argument is bridge_probe."""
import json, os, pathlib, shutil, subprocess, sys, tempfile, time
binary, probe = map(lambda p: pathlib.Path(p).resolve(), sys.argv[1:3])
root = pathlib.Path(tempfile.mkdtemp(prefix='o3-bridge-rss-', dir='/var/tmp/o3-build/embed'))
assert subprocess.check_output(['stat','-f','-c','%T',str(root)], text=True).strip() != 'tmpfs'
server = root/'o3-server'
shutil.copy2(binary, server)
def status(pid):
    result = {}
    for line in pathlib.Path(f'/proc/{pid}/status').read_text().splitlines():
        key, _, value = line.partition(':')
        if key in ('VmRSS','VmHWM','RssAnon','RssFile','RssShmem','Threads'):
            result[key] = int(value.split()[0])
    return result
client = None
with (root/'server.log').open('w') as log:
    process = subprocess.Popen([str(server),'serve','--base-dir',str(root/'server'),'--port','0'],stdout=log,stderr=log)
    try:
        for _ in range(200):
            if (root/'server/omabridge/endpoint.json').exists(): break
            if process.poll() is not None: raise RuntimeError((root/'server.log').read_text())
            time.sleep(.05)
        else: raise RuntimeError('bridge readiness timeout')
        time.sleep(3)
        idle = status(process.pid)
        client = subprocess.Popen([str(probe),str(root)],stdout=log,stderr=log)
        for _ in range(300):
            if (root/'ready').exists(): break
            if client.poll() is not None: raise RuntimeError(f'bridge_probe exited {client.returncode} before RPC readiness: '+(root/'server.log').read_text())
            time.sleep(.05)
        else: raise RuntimeError('bridged RPC timeout')
        time.sleep(3)
        connected = status(process.pid)
        record = {'binary':str(server),'binary_bytes':server.stat().st_size,'filesystem':subprocess.check_output(['stat','-f','-c','%T',str(root)],text=True).strip(),'units':'KiB (except Threads and binary_bytes)','idle':idle,'one_bridged_authenticated_rpc_client':connected,'seed_messages':0,'provider':'none','relay':'disabled','client_transport':'real t3-protocol pairing + server.getConfig, WebSocket held open','host_service_transport':'32 KiB Tokio duplex, no TCP target','measured_on':'2026-10-31','measurement':'Linux /proc/PID/status; binary and state on disk; 3 seconds settling per sample','artifacts':str(root)}
        path = pathlib.Path(__file__).resolve().parent.parent/'docs/rss-measurement.json'
        document = json.loads(path.read_text()); document['embedded_bridge'] = record
        path.write_text(json.dumps(document,indent=2)+'\n')
        print(json.dumps(record,indent=2))
    finally:
        if client is not None:
            if client.poll() is None: client.terminate()
            client.wait(timeout=15)
        if process.poll() is None: process.terminate()
        process.wait(timeout=15)
