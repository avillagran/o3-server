#!/usr/bin/env python3
"""Isolated native desktop management against the embedded bridge (no services)."""
import json, os, pathlib, subprocess, tempfile, time, urllib.request
BUILD_ROOT = os.environ.get('O3_BUILD_ROOT') or os.path.expanduser('~/.cache/o3-build')
os.makedirs(os.path.join(BUILD_ROOT, 'tmp'), exist_ok=True)
root = pathlib.Path(BUILD_ROOT)
server = pathlib.Path(os.environ.get('O3_BIN', str(root / 'main/debug/o3-server'))).resolve()
client = pathlib.Path(os.environ.get('O3_DESKTOP_BIN', str(root / 'main/debug/omarchy-t3-client'))).resolve()
with tempfile.TemporaryDirectory(prefix='db-', dir=root) as temp:
    p = pathlib.Path(temp)
    (p/'bin').mkdir()
    (p/'bin/t3').symlink_to(server)
    env = {**os.environ, 'HOME':temp, 'T3CODE_HOME':str(p/'t3'), 'XDG_CONFIG_HOME':str(p/'config'),
           'XDG_DATA_HOME':str(p/'data'), 'XDG_STATE_HOME':str(p/'state'), 'XDG_RUNTIME_DIR':str(p/'run'),
           'CODEX_HOME':str(p/'codex'), 'CLAUDE_CONFIG_DIR':str(p/'claude'), 'TMPDIR':str(root/'tmp'),
           'PATH':str(p/'bin')+':/usr/bin:/bin'}
    process = subprocess.Popen([str(server),'serve','--port','0'], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic()+30
        while not (p/'t3/omabridge/host.json').exists() or not (p/'t3/omabridge/control.sock').exists():
            assert process.poll() is None and time.monotonic()<deadline
            time.sleep(.05)
        def call(command, request=None):
            out = subprocess.check_output([str(client),command], input=json.dumps(request) if request else None, text=True, env=env, timeout=40)
            return json.loads(out)
        status=call('omabridge-status')
        assert status['available'] and status['identity'] and status['peers']==[], status
        def manage(request):
            result=call('omabridge-manage', request)
            assert result['status']==0, result
            return result['output']
        read=manage({'action':'read'})
        assert read['published']['backend']=='embedded', read
        manage({'action':'unpublish','confirmed':True})
        manage({'action':'publish','confirmed':True,'t3':True,'ssh':False,'mcp':False})
        invitation=manage({'action':'invite','confirmed':True,'services':['t3'],'directory':temp})['created']['path']
        guest=p/'guest'
        guest.mkdir()
        guest_env={**env,'HOME':str(guest),'T3CODE_HOME':str(guest/'t3'),
                   'XDG_CONFIG_HOME':str(guest/'config'),'XDG_DATA_HOME':str(guest/'data'),
                   'XDG_STATE_HOME':str(guest/'state'),'XDG_RUNTIME_DIR':str(guest/'run')}
        guest_process=subprocess.Popen([str(server),'serve','--port','0'],env=guest_env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        try:
            deadline=time.monotonic()+30
            while not (guest/'t3/omabridge/control.sock').exists():
                assert guest_process.poll() is None and time.monotonic()<deadline
                time.sleep(.05)
            def guest_manage(request):
                result=json.loads(subprocess.check_output([str(client),'omabridge-manage'],input=json.dumps(request),text=True,env=guest_env,timeout=40))
                assert result['status']==0,result
                return result['output']
            paired=guest_manage({'action':'pair','confirmed':True,'path':invitation})
            pending=manage({'action':'read'})['pending']
            assert len(pending)==1,pending
            manage({'action':'approve','confirmed':True,'peer':pending[0]['id']})
            if paired['paired']['status']=='pending':
                paired=guest_manage({'action':'pair-retry','confirmed':True,'id':paired['paired']['id']})
            assert paired['paired']['status']=='approved',paired
            host=manage({'action':'read'})
            assert len(host['peers'])==1
            host_id=host['device']['id']
            base=[str(server),'--state-dir',str(guest/'t3/omabridge')]
            sharing=json.loads(subprocess.check_output([str(client),'omabridge-share'],input=json.dumps({'action':'run'}),env=guest_env,text=True,timeout=90))
            row=next(r for r in sharing['peers'] if r['peer']==host_id)
            assert row['shared'], sharing
            state=guest/'t3/omabridge'
            assert (state/'shares.json').exists() and (state/'forwards.json').exists()
            assert not (guest/'config/systemd/user').exists()
            port=row['port']
            guest_process.terminate();guest_process.wait(timeout=10)
            guest_process=subprocess.Popen([str(server),'serve','--port','0'],env=guest_env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            deadline=time.monotonic()+30
            while True:
                try:
                    restored=json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/.well-known/t3/environment',timeout=2))
                    assert restored
                    break
                except (OSError,ValueError):
                    assert time.monotonic()<deadline,'persistent forward restore timeout'
                    time.sleep(.1)
            receipt=json.loads(subprocess.check_output(base+['t3-pair','--peer',host_id],env=guest_env,text=True,timeout=30))
            assert receipt['credential']
            forward=subprocess.Popen(base+['forward','--peer',host_id,'--service','t3','--listen','127.0.0.1:0'],env=guest_env,stdout=subprocess.PIPE,text=True)
            try:
                import select
                assert select.select([forward.stdout],[],[],30)[0], 'forward readiness timeout'
                ready=json.loads(forward.stdout.readline())
                assert ready['event']=='forwarding',ready
                descriptor=json.load(urllib.request.urlopen('http://'+ready['listen']+'/.well-known/t3/environment',timeout=15))
                assert descriptor
            finally:
                forward.terminate();forward.wait(timeout=10)
        finally:
            guest_process.terminate()
            guest_process.wait(timeout=10)
        routes=p/'config/omarchy-t3-code/omabridge-routes.json'
        routes.parent.mkdir(parents=True,exist_ok=True)
        explicit=p/'standalone'
        routes.write_text(json.dumps({'version':1,'stateDir':str(explicit),'routes':{}}))
        selected=call('omabridge-status')
        assert selected['stateDir']==str(explicit) and not selected['identity'],selected
        routes.unlink()
        assert call('omabridge-status')['available']
        print(json.dumps({'status':'pass' ,'available':True,'identity':True,'peers':0,'read':True,'publish':True,'unpublish':True,'pairing':True,'pairedPeers':1,'t3Pair':True,'forward':True}))
    finally:
        process.terminate()
        try: process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill(); process.wait()
