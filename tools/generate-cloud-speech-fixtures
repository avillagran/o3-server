#!/usr/bin/env python3
"""Run the whole pinned cloud speech layer with one canonical Effect."""
import argparse,os,pathlib,subprocess,json,hashlib,stat
from speech_runtime_admission import require_rootless
import node_admission
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--source',required=True,type=pathlib.Path)
p.add_argument('--deps',required=True,type=pathlib.Path)
p.add_argument('--node',required=True,type=pathlib.Path,help='Existing admitted immutable Node26.13 snapshot (mode0500)')
p.add_argument('--out',required=True,type=pathlib.Path,help='New retained evidence directory')
p.add_argument('--secret-authority',action='store_true',help='Run whole Cloud + actual application/core resolver authority oracle')
p.add_argument('--http',action='store_true',help='Run whole HTTP admission and typed error serialization')
p.add_argument('--postprocess',action='store_true',help='Run whole transcript postprocessing layer/prompt oracle')
p.add_argument('--image',default='localhost/o3-server-tests:local')
a=p.parse_args();root=pathlib.Path(__file__).resolve().parent.parent;require_rootless()
revision='83a3674ffd84ffb33de768210c806cb1ac53fd80'
assert subprocess.check_output(['git','-C',str(a.source),'rev-parse','HEAD'],text=True).strip()==revision
subprocess.run(['git','-C',str(a.source),'diff','--quiet',revision,'--'],check=True)
relative='apps/server/src/speech/'+('http.ts' if a.http else 'postProcessing.ts' if a.postprocess else 'CloudSpeech.ts')
file=a.source/relative
expected=subprocess.check_output(['git','-C',str(a.source),'show',revision+':'+relative])
assert file.read_bytes()==expected
node,info=node_admission._open(a.node)
with node:
 assert stat.S_IMODE(info.st_mode)&0o222==0,'Reuse a readonly admitted snapshot, not mutable Node cache'
 node_sha=hashlib.file_digest(node,'sha256').hexdigest()
assert node_sha=='0adde40d1b7dfa57c8bc83cbc319758c3ec6ebba21363bb2fa752ea6b267ad1b'
assert json.loads((a.deps/'node_modules/effect/package.json').read_text())['version']=='4.1.2'
a.out.mkdir(mode=0o700)
cmd=['podman','--remote=false','run','--rm','--pull=never','--http-proxy=false','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--read-only','--network=none','--cap-drop=ALL','--security-opt=no-new-privileges','--memory=512m','--tmpfs','/tmp:rw,size=64m,mode=1777','-v',f'{root}:/source:ro','-v',f'{a.source}:/native:ro','-v',f'{a.deps}:/deps:ro','-v',f'{a.node.parent}:/node-bin:ro','-v',f'{a.out}:/out:rw',a.image,'/node-bin/'+a.node.name,'--import','/source/tools/reference/cloud-speech-4314/hook.mjs','/source/tools/reference/cloud-speech-4314/'+('secret-authority.mjs' if a.secret_authority else 'http.mjs' if a.http else 'postprocess.mjs' if a.postprocess else 'oracle.mjs'),'/out/fixtures.json']
with (a.out/'oracle.log').open('x') as log:r=subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT)
(a.out/'result.json').write_text(json.dumps({'returncode':r.returncode,'nativeRevision':revision,'sourceSha256':hashlib.sha256(expected).hexdigest(),'nodeSha256':node_sha,'effectVersion':'4.1.2','bindings':('whole original CloudSpeech + application/core SecretResolver + actual OnePassword definition; synthetic driver/read and fetch boundaries; no vault CLI/network/filesystem effects' if a.secret_authority else 'whole original HTTP route + typed error schema; logical principal/domain and no filesystem effects' if a.http else 'whole original scoped postProcessing/prompt builder + actual Schema; logical FS/Settings/TextGeneration fixtures; no provider/filesystem effects' if a.postprocess else 'whole native CloudSpeech layer + actual FetchHttpClient/Schema; settings/resolver/upstream fixture boundaries; no provider network')},indent=2)+'\n');print(a.out);print((a.out/'oracle.log').read_text().splitlines()[-1] if r.returncode==0 else (a.out/'oracle.log').read_text()[-4000:]);raise SystemExit(r.returncode)
