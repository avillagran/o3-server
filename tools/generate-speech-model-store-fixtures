#!/usr/bin/env python3
"""Run the whole pinned ModelStore with virtual FS/HTTP and one canonical Effect."""
import argparse,os,pathlib,subprocess,json,hashlib,stat
from speech_runtime_admission import require_rootless
import node_admission
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--source',required=True,type=pathlib.Path)
p.add_argument('--deps',required=True,type=pathlib.Path)
p.add_argument('--node',required=True,type=pathlib.Path,help='Existing admitted immutable Node26.13 snapshot (mode0500)')
p.add_argument('--out',required=True,type=pathlib.Path,help='New retained evidence directory')
p.add_argument('--image',default='localhost/o3-server-tests:local')
a=p.parse_args();root=pathlib.Path(__file__).resolve().parent.parent;require_rootless()
revision='83a3674ffd84ffb33de768210c806cb1ac53fd80'
assert subprocess.check_output(['git','-C',str(a.source),'rev-parse','HEAD'],text=True).strip()==revision
file=a.source/'apps/server/src/speech/SpeechModelStore.ts'
expected=subprocess.check_output(['git','-C',str(a.source),'show',revision+':apps/server/src/speech/SpeechModelStore.ts'])
assert file.read_bytes()==expected
node,info=node_admission._open(a.node)
with node:
 assert stat.S_IMODE(info.st_mode)&0o222==0,'Reuse a readonly admitted snapshot, not mutable Node cache'
 node_sha=hashlib.file_digest(node,'sha256').hexdigest()
a.out.mkdir(mode=0o700)
cmd=['podman','--remote=false','run','--rm','--pull=never','--http-proxy=false','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--read-only','--network=none','--cap-drop=ALL','--security-opt=no-new-privileges','--memory=512m','--tmpfs','/tmp:rw,size=64m,mode=1777','-v',f'{root}:/source:ro','-v',f'{a.source}:/native:ro','-v',f'{a.deps}:/deps:ro','-v',f'{a.node.parent}:/node-bin:ro','-v',f'{a.out}:/out:rw',a.image,'/node-bin/'+a.node.name,'--import','/source/tools/reference/speech-model-store-4314/hook.mjs','/source/tools/reference/speech-model-store-4314/oracle.mjs','/out/fixtures.json']
with (a.out/'oracle.log').open('x') as log:r=subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT)
(a.out/'result.json').write_text(json.dumps({'returncode':r.returncode,'nativeRevision':revision,'sourceSha256':hashlib.sha256(expected).hexdigest(),'nodeSha256':node_sha,'effectVersion':'4.1.2','filesystem':'virtual operations only, no real native removal'},indent=2)+'\n');print(a.out);print((a.out/'oracle.log').read_text());raise SystemExit(r.returncode)
