#!/usr/bin/env python3
"""Derive the compiled engine-file allowlist from independently verified pinned archives."""
import argparse
import hashlib
import json
import os
import pathlib
import subprocess
from speech_runtime_admission import require_rootless

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--bundle', required=True, type=pathlib.Path)
parser.add_argument('--out', required=True, type=pathlib.Path)
parser.add_argument('--evidence', required=True, type=pathlib.Path)
parser.add_argument('--image', default='localhost/o3-server-tests:local')
args = parser.parse_args()
require_rootless()
root = pathlib.Path(__file__).resolve().parent.parent
args.evidence.mkdir(mode=0o700)
command = ['podman', '--remote=false', 'run', '--rm', '--pull=never', '--http-proxy=false',
           '--userns=keep-id', '--user', f'{os.getuid()}:{os.getgid()}', '--read-only',
           '--network=none', '--cap-drop=ALL', '--security-opt=no-new-privileges',
           '--pids-limit=64', '--memory=512m', '--tmpfs', '/tmp:rw,size=64m,mode=1777',
           '-v', f'{root}:/source:ro', '-v', f'{args.bundle}:/inputs:ro', args.image,
           'python3', '/source/tools/verify-speech-engine', '/inputs']
with (args.evidence / 'verification.log').open('x') as output:
    checked = subprocess.run(command, stdout=output, stderr=subprocess.STDOUT)
if checked.returncode:
    raise SystemExit(checked.returncode)
pins = json.loads((root / 'runtime/speech/engine-packages-4314.json').read_text())
receipt_bytes = (args.bundle / 'engine-receipt.json').read_bytes()
receipt = json.loads(receipt_bytes)
# Produce from immutable in-memory bytes whose archive SRI has been checked,
# rather than trusting a receipt that could change after graph verification.
producer = command[:-3] + ['python3', '/source/tools/speech_engine_manifest.py']
with (args.evidence / 'manifest.json').open('x') as output:
    result = subprocess.run(producer, stdout=output, stderr=subprocess.PIPE)
if result.returncode:
    (args.evidence / 'producer-error.log').write_bytes(result.stderr)
    raise SystemExit(result.returncode)
manifest_bytes = (args.evidence / 'manifest.json').read_bytes()
assert len(manifest_bytes) < 128 * 1024
manifest = json.loads(manifest_bytes)
files = manifest['files']
assert len(files) == 140
with args.out.open('xb') as output:
    output.write(manifest_bytes)
proof = {'returncode': 0, 'packages': len(receipt['packages']), 'files': len(files),
         'manifestSha256': hashlib.sha256(args.out.read_bytes()).hexdigest(),
         'receiptSha256': hashlib.sha256(receipt_bytes).hexdigest(),
         'verification': 'Every archive SRI and every extracted regular file independently checked; no network or scripts'}
(args.evidence / 'result.json').write_text(json.dumps(proof, indent=2) + '\n')
print(json.dumps(proof))
