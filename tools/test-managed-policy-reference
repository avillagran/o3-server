#!/usr/bin/env python3
"""Compile policy intake and check pinned policy cases in private rootless Podman."""
import argparse
import json
import os
import pathlib
import subprocess
import tempfile
import uuid

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('reference_root', type=pathlib.Path)
parser.add_argument('--from-case', type=int, default=0)
parser.add_argument('--evidence', type=pathlib.Path)
options = parser.parse_args()
root = pathlib.Path(__file__).resolve().parent.parent
reference = options.reference_root.resolve()
assert (reference / 't3').is_file()
assert 0 <= options.from_case < 76
evidence = options.evidence or pathlib.Path(tempfile.mkdtemp(prefix='o3-managed-policy-oracle-', dir='/var/tmp'))
evidence.mkdir(parents=True, exist_ok=True)
env = dict(os.environ)
env.setdefault('CARGO_TARGET_DIR', '/var/tmp/o3-server/fresh-context-target')
env.setdefault('CARGO_BUILD_JOBS', '2')
build = subprocess.run(['cargo', 'test', '--locked', '--no-default-features', '--test', 'managed_policy', '--no-run', '--message-format=json'], cwd=root, env=env, capture_output=True, text=True)
if build.returncode:
    for line in build.stdout.splitlines():
        message = json.loads(line).get('message', {})
        if message.get('rendered'):
            print(message['rendered'], flush=True)
    print(build.stderr, flush=True)
    raise SystemExit(build.returncode)
binary = next(pathlib.Path(v['executable']) for line in build.stdout.splitlines() if (v := json.loads(line)).get('executable') and v.get('target', {}).get('name') == 'managed_policy')
node = pathlib.Path(subprocess.check_output(['mise', 'where', 'node'], text=True).strip()).resolve()
name = 'o3-managed-policy-oracle-' + uuid.uuid4().hex
args = ['podman', 'run', '--rm', '--name', name, '--userns=keep-id', '--user', f'{os.getuid()}:{os.getgid()}', '--read-only', '--tmpfs', '/tmp:rw,exec,size=1g,mode=1777', '--cap-drop=ALL', '--security-opt=no-new-privileges', '--pids-limit=512', '--memory=3g', '--network=none', '--workdir=/tmp']
for source, destination in [(root, root), (binary.parent, '/test-bin'), (reference, '/reference'), (node, '/native/node')]:
    args += ['-v', f'{source}:{destination}:ro']
for key, value in {'HOME': '/tmp/home', 'TMPDIR': '/tmp', 'XDG_CONFIG_HOME': '/tmp/config', 'XDG_DATA_HOME': '/tmp/data', 'XDG_STATE_HOME': '/tmp/state', 'PATH': '/native/node/bin:/usr/bin:/bin', 'O3_HEADLESS_CONTAINER': '1', 'T3_REFERENCE_BIN': '/reference/t3', 'O3_POLICY_ORACLE_FROM': str(options.from_case)}.items():
    args += ['--env', f'{key}={value}']
args += [os.environ.get('O3_HEADLESS_IMAGE', 'localhost/android-sandbox:latest'), 'sh', '-c', 'set -eu; umask 077; mkdir -p "$HOME"; exec "$1" --ignored --nocapture --test-threads=1', 'managed-policy-reference', f'/test-bin/{binary.name}']
print(f'Policy oracle evidence: {evidence}', flush=True)
try:
    result = subprocess.run(args, cwd=root, timeout=600, capture_output=True, text=True)
    (evidence / 'output.log').write_text(result.stdout + result.stderr)
    (evidence / 'result.json').write_text(json.dumps({'returncode': result.returncode, 'reference': str(reference), 'fromCase': options.from_case, 'caseCount': 76 - options.from_case, 'rootless': True, 'network': 'none', 'readOnlySourceRuntime': True, 'binary': str(binary)}, indent=2) + '\n')
    print(result.stdout + result.stderr, flush=True)
finally:
    subprocess.run(['podman', 'stop', '--time', '3', name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
raise SystemExit(result.returncode)
