    {
      "name": "preview_evaluate",
      "description": "Run JavaScript in the page. It can change page state. Returns `{value}`, up to 64 KB. Needs your tab, or an unclaimed one. To read a tab the user drives, use `preview_snapshot`. Page tools reached here: read data only, never create, save, or display. Show results with `html_render`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expression": {
            "type": "string",
            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
            "minLength": 1,
            "maxLength": 64000
          },
          "awaitPromise": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Default true."
              },
              {
                "type": "null"
              }
            ]
          },
          "returnByValue": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "False returns a ref. Default true."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "expression"
        ],
        "additionalProperties": true
      },
      "readonly": false,
      "destructive": true,
      "idempotent": false,
      "openWorld": true
    },
