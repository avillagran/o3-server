    {
      "name": "preview_snapshot",
      "description": "Use it only when the current request asks for browser work, including checking an edit in the browser. Never use it unasked to verify your own edit, or to repeat a snapshot from an earlier turn. Works on a tab the user is driving. Returns page state, elements, diagnostics, and screenshot size. Target one element with `locator='aria-ref=<ref>'` from `accessibilityTree`, even in frames. Refs die on navigation, a new snapshot, or handoff. Text caps near 20 KB; on your own or an unclaimed tab, `preview_evaluate` reads more. To show a screenshot when asked: `save=true`, then embed ![alt](screenshotPath).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "includeImage": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Default false. True only to see the page."
              },
              {
                "type": "null"
              }
            ]
          },
          "save": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Write PNG, return `screenshotPath`."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "readonly": false,
      "destructive": false,
      "idempotent": false,
      "openWorld": true
    },
    {
      "name": "preview_act",
      "description": "Act on the chosen tab. Target with `locator='aria-ref=<ref>'` from `preview_snapshot`; `x` and `y` go together. `timeoutMs` defaults to 15000. click: `button`, `clickCount` 1 to 3. type: literal `text`, `clear=true` replaces it. hover: shows menus or tooltips. select: `values` in one native <select>, by value or label; for a custom dropdown, click it open, then click the option. drag: `source` onto `target`. upload: absolute `paths` answer the file picker `preview_status` reports, [] cancels it, or a `locator` sets an <input type=file>. press: one `key`, such as 'Enter', with `modifiers`, to the focused element; click a field first to focus it. scroll: the tab, or one container with a locator; positive `deltaY` scrolls down, positive `deltaX` right.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "click",
              "type",
              "hover",
