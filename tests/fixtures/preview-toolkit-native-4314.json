{
  "complete": true,
  "wholeToolkit": true,
  "injectedBoundaries": "Opaque service dependencies only; actual Tool/Toolkit/Schema/contracts",
  "catalog": [
    {
      "name": "preview_dialog",
      "description": "Accept or dismiss the dialog `preview_status` reports. Pass `promptText` to accept a prompt. Needs your own tab, or an unclaimed one. Desktop hosts may not support this.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "accept": {
            "type": "boolean"
          },
          "promptText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "accept"
        ],
        "additionalProperties": true
      },
      "readonly": false,
      "destructive": true,
      "idempotent": false,
      "openWorld": true
    },
    {
      "name": "preview_status",
      "description": "Report preview tab state: owner, pending dialog, URL, title, loading, viewport, and size. `tabs` lists this thread's tabs. `profiles` lists logins for `preview_open`. Read any listed tab. Act only on your tab, or an unclaimed tab with no human in control.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "readonly": true,
      "destructive": false,
      "idempotent": true,
      "openWorld": true
    },
    {
      "name": "preview_open",
      "description": "Open a preview tab in this thread and show it. For a dev server, pass `target` instead of `url`. `open=false` keeps it in the background. Reuses your current tab unless `tabId` or `reuseExistingTab=false` says otherwise. Parallel subagents in one session must each use `reuseExistingTab=false`, then their own returned `tabId`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "description": "First page URL. Absolute http(s) URL, or a bare host (https; http for loopback). Omit to open a blank tab."
          },
          "open": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Show the preview to the user. Default true. False for background only."
              },
              {
                "type": "null"
              }
            ]
          },
          "show": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Old alias for `open`."
              },
              {
                "type": "null"
              }
            ]
          },
          "reuseExistingTab": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Reuse `tabId`, or your current tab. Default true. False makes a new tab."
              },
              {
                "type": "null"
              }
            ]
          },
          "profileId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Profile id or name from preview_status, for a new tab. Default: the user's. A tab keeps its profile."
          },
          "target": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "environment-port"
                    ]
                  },
                  "port": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 65536,
                    "description": "Dev-server port here."
                  },
                  "protocol": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "http",
                          "https"
                        ],
                        "description": "Default http."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Path, query, and fragment, such as /settings?tab=account."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "port"
                ],
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "readonly": false,
      "destructive": true,
      "idempotent": false,
      "openWorld": true
    },
    {
      "name": "preview_navigate",
      "description": "Navigate the chosen tab. Pass `url` for a website, or `target:{kind:'environment-port',port}` for a dev server. Exactly one of `url` and `target`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "anyOf": [
              {
                "type": "string"
              },
