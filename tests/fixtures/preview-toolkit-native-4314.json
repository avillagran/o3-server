            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "description": "Website URL. Absolute http(s) URL, or a bare host (https; http for loopback). For public pages."
          },
          "target": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "url"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Website URL. Absolute http(s) URL, or a bare host (https; http for loopback)."
                  }
                },
                "required": [
                  "kind",
                  "url"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "environment-port"
                    ]
                  },
                  "port": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 65536,
                    "description": "Dev-server port here."
                  },
                  "protocol": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "http",
                          "https"
                        ],
                        "description": "Default http."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Path, query, and fragment, such as /settings?tab=account."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "port"
                ],
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "readiness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "load",
                  "domContentLoaded",
                  "none"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Default 'load'. 'none': return at once."
          },
          "timeoutMs": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 60000,
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "Default 15000."
          }
        },
        "additionalProperties": true
      },
      "readonly": false,
      "destructive": false,
      "idempotent": false,
      "openWorld": true
    },
